# ── FiscalHub · configuração ─────────────────────────────────────────
# Copie para .env e ajuste. Nunca envie o .env para o Git.

# Porta HTTP do servidor
PORT=3000

# Endereço público do sistema (usado para checar a origem das requisições).
# Ex.: https://fiscal.seuescritorio.com.br
APP_URL=http://localhost:3000

# Banco de dados PostgreSQL. Se ficar vazio, o sistema usa um banco embutido
# (PGlite) gravado em DATA_DIR/pglite — bom para testes e escritórios pequenos.
# Ex.: postgres://fiscalhub:senha@localhost:5432/fiscalhub
DATABASE_URL=

# Pasta onde ficam o banco embutido e os arquivos enviados (XML, guias, recibos).
DATA_DIR=./data

# Chave para criptografar segredos de 2FA. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Primeiro administrador (usado só por `npm run seed`)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seuescritorio.com.br
ADMIN_PASSWORD=

# Tamanho máximo de cada arquivo enviado, em MB
MAX_UPLOAD_MB=20

# Duração da sessão, em horas
SESSION_HOURS=12

# Fuso horário do escritório (datas de vencimento, "hoje", entregas no prazo)
FUSO_HORARIO=America/Sao_Paulo

# Só para docker-compose: senha do PostgreSQL
POSTGRES_PASSWORD=
