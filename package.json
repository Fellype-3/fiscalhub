{
  "name": "fiscalhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FiscalHub — controle da rotina fiscal e das demandas de escritório contábil",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild server/scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed.js",
    "start": "NODE_ENV=production node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx server/scripts/seed.ts",
    "seed:demo": "tsx server/scripts/seed.ts --demo",
    "demo:limpar": "tsx server/scripts/seed.ts --limpar-demo",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@trpc/client": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.64.0",
    "multer": "^2.5.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "wouter": "^3.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
